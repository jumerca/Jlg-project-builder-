’est pas ton projet')};J.originalTerritory=W.researchTerritory;W.researchTerritory=territory}
function events(){document.addEventListener('click',async e=>{let x;if((x=e.target.closest('[data-v109-close]'))){J.close();return}if((x=e.target.closest('.logo-stage [data-jump="project"]'))){e.preventDefault();e.stopImmediatePropagation();if(J.example())newProject();showPage('project');setTimeout(()=>$('#v109PlacePanel')?.scrollIntoView({behavior:'smooth'}),80);return}if((x=e.target.closest('[data-v109-new]'))){newProject();showPage('project');setTimeout(()=>$('#v109PlacePanel')?.scrollIntoView({behavior:'smooth'}),80);return}if((x=e.target.closest('[data-v109-territory]'))){commitPlace();showPage('territory');setTimeout(()=>$('#researchTerritoryBtn')?.click(),100);return}if((x=e.target.closest('[data-v109-control]'))&&!e.target.closest('button,select,input,textarea,a'))return J.control(+x.dataset.v109Control);if((x=e.target.closest('[data-v109-risk]'))&&!e.target.closest('button,select,input,textarea,a'))return J.risk(+x.dataset.v109Risk);if((x=e.target.closest('[data-v109-gate]'))&&!e.target.closest('button,select,input,textarea,a'))return J.gate(+x.dataset.v109Gate);if((x=e.target.closest('[data-v109-phase]'))&&!e.target.closest('button,select,input,textarea,a'))return J.phase(+x.dataset.v109Phase);if((x=e.target.closest('[data-v109-raci]'))&&!e.target.closest('button,select,input,textarea,a'))return J.raci(+x.dataset.v109Raci);if((x=e.target.closest('[data-v109-kpi]'))){const i=+x.dataset.v109Kpi;return i===0?showPage('control'):i===3?J.risk(0):showPage('finance')}if((x=e.target.closest('[data-v109-visual]'))){e.preventDefault();e.stopImmediatePropagation();return J.visual(x.dataset.v109Visual)}if((x=e.target.closest('[data-v109-route]'))){J.close();return showPage(x.dataset.v109Route)}if((x=e.target.closest('[data-v109-draft]')))return J.draft(+x.dataset.v109Draft);if((x=e.target.closest('[data-v109-pdf]')))return J.downloadPdf?.(x.dataset.v109Pdf,{index:x.dataset.v109Index,visual:x.dataset.v109Visual});if((x=e.target.closest('[data-v109-pagepdf]')))return J.downloadPdf?.(({analysis:'analysis',control:'control',finance:'finance',risks:'risks',pilot:'pilot',visuals:'plan',roadmap:'roadmap',documents:'documents',execution:'execution',territory:'territory',premium:'premium',dossier:'master'})[x.dataset.v109Pagepdf]);if(e.target.closest('[data-v109-copy-draft]')){const t=$('#v109DraftText')?.value||'';try{await navigator.clipboard.writeText(t);toast('Brouillon copié')}catch{}return}if(e.target.closest('[data-v109-copy-visual]')){const t=$('#v109VisualPrompt')?.value||'';try{await navigator.clipboard.writeText(t);toast('Brief copié')}catch{}return}if(e.target.closest('[data-v109-chat]')){try{await navigator.clipboard.writeText($('#v109VisualPrompt')?.value||'')}catch{}return W.open('https://chatgpt.com/','_blank','noopener')}if(e.target.closest('[data-v109-logo-clear]')){state.v109.identity.logoData='';save(false);syncId()}},true);document.addEventListener('input',e=>{if(e.target.closest('#v109PlacePanel')){commitPlace();save(false)}if(e.target.closest('#v109Identity')){commitId();save(false)}});document.addEventListener('change',async e=>{if(e.target.id==='v109LogoFile'){await logoFile(e.target.files?.[0]);e.target.value=''}else if(e.target.closest('#v109PlacePanel')){commitPlace();save(false);renderAll()}else if(e.target.closest('#v109Identity')){commitId();save(false)}});document.addEventListener('keydown',e=>{if(e.key==='Escape')J.close()})}
function init(){if(!state.name&&!state.analysis&&state.site==='unknown'){state.type='free';if($('#type'))$('#type').value='free'}J.ensure();const l=document.createElement('link');l.rel='stylesheet';l.href='./v10-9.css?v='+V;l.dataset.v109Css='1';document.head.appendChild(l);placePanel();identity();planHelp();wrappers();events();document.title='JLG Project Lab 360 - V10.9';if($('.version-pill'))$('.version-pill').textContent='V10.9';if($('.brand small'))$('.brand small').textContent=/JLGProjectLabAndroid/i.test(navigator.userAgent)?'V10.9 Android · PDF natifs':'V10.9 · actions & PDF';if($('.logo-stage .eyebrow'))$('.logo-stage .eyebrow').textContent='JLG PROJECT LAB 360 · V10.9';$$('#heroTestBtn,#testBtn').forEach(b=>b.textContent='Voir l’exemple guinguette');banner();decorate();pdfButtons();if($('#researchTerritoryBtn'))$('#researchTerritoryBtn').onclick=territory;setTimeout(()=>{syncPlace();syncId();decorate();pdfButtons();banner()},450)}
init();
})();

