const names={master:'dossier-complet',decision:'fiche-decision',analysis:'analyse-360',control:'tour-de-controle','control-one':'controle',finance:'finances',risks:'risques',pilot:'pilotage',plan:'plan-fonctionnel',concept:'croquis-concept',storyboard:'storyboard',roadmap:'feuille-de-route',documents:'documents-autorisations',execution:'montage-operationnel',territory:'territoire',premium:'audit-premium','visual-brief':'brief-visuel'};
J.downloadPdf=async(type,opt={})=>{try{toast('Création du PDF…');J.ensure?.();const d=makeDoc(type,opt),bytes=pdf(d),blob=new Blob([bytes],{type:'application/pdf'}),fn=`${slug2(state.name)||'projet'}-${names[type]||type}-v10-9.pdf`;J.smartDownload(fn,blob);toast(W.JLGAndroid?'PDF enregistré dans Téléchargements':'PDF téléchargé')}catch(e){console.error(e);toast('Erreur PDF : '+e.message)}};
// Existing downloads now work inside the APK too.
W.downloadBlobV9=(name,content,type='text/plain;charset=utf-8')=>J.smartDownload(name,new Blob([content],{type}));
W.svgDownload=(name,svg)=>J.smartDownload(name,new Blob([svg],{type:'image/svg+xml;charset=utf-8'}));
W.exportRoadmap=()=>{const r=[['Horizon','Action','Détail','Catégorie','Responsable','Critique','Statut'],...roadmapItems().map(x=>[x.h+' jours',x.title,x.detail,x.category,x.owner,x.critical?'Oui':'Non',roadmapStatus(x.id)])],csv=r.map(a=>a.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\n');J.smartDownload((slug2(state.name)||'projet')+'-roadmap.csv',new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));toast('Feuille de route téléchargée')};
W.exportJson=()=>{readProject();financeInputs();J.smartDownload((slug2(state.name)||'projet')+'-project360.json',new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));toast('Sauvegarde JSON téléchargée')};
