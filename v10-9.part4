r,h=im.height*r;x.fillStyle='#fff';x.fillRect(0,0,420,420);x.drawImage(im,(420-w)/2,(420-h)/2,w,h);URL.revokeObjectURL(u);state.v109.identity.logoData=c.toDataURL('image/jpeg',.86);save(false);syncId();toast('Logo ajouté')}
function decorate(){if(state.analysis){[...$('#controlList')?.children||[]].forEach((e,i)=>{e.dataset.v109Control=i;e.classList.add('v109-clickable');e.tabIndex=0;if(!e.querySelector('.v109-open-hint'))e.insertAdjacentHTML('beforeend','<span class="v109-open-hint">Voir pourquoi →</span>')});$$('#riskList .risk').slice(1).forEach((e,i)=>{e.dataset.v109Risk=i;e.classList.add('v109-clickable');e.tabIndex=0})}$$('#gateList .gate').forEach((e,i)=>{e.dataset.v109Gate=i;e.classList.add('v109-clickable');e.tabIndex=0;if(!e.querySelector('.v109-open-hint'))e.insertAdjacentHTML('beforeend','<span class="v109-open-hint">Comprendre →</span>')});$$('#gantt .gantt-row').forEach((e,i)=>{e.dataset.v109Phase=i;e.classList.add('v109-clickable');e.tabIndex=0});$$('#raci tbody tr').forEach((e,i)=>{e.dataset.v109Raci=i;e.classList.add('v109-clickable');e.tabIndex=0});$$('#miniRisks .mini-risk').forEach((e,i)=>{e.dataset.v109Risk=i;e.classList.add('v109-clickable')});$$('#miniGates .mini-gate').forEach((e,i)=>{e.dataset.v109Gate=i;e.classList.add('v109-clickable')});$$('#nextActions .next-action').forEach(e=>{const n=e.querySelector('b')?.textContent.trim(),i=controls().findIndex(c=>c.name===n);if(i>=0){e.dataset.v109Control=i;e.classList.add('v109-clickable')}});$$('#cockpitKpis .kpi').forEach((e,i)=>{e.dataset.v109Kpi=i;e.classList.add('v109-clickable')});$$('#visualBriefs [data-visual-brief]').forEach(e=>{const n=e.querySelector('h3')?.textContent.trim()||'';e.dataset.v109Visual=n;e.classList.add('v109-clickable');const p=e.querySelector('.pill');if(p)p.textContent=['Plan 2D','Croquis concept','Infographie','Storyboard vidéo'].includes(n)?'Générer le PDF →':'Préparer pour IA →'})}
function planHelp(){if($('#v109PlanHelp'))return;const t=$('#visuals .plan-toolbar');t?.insertAdjacentHTML('beforebegin','<div id="v109PlanHelp" class="callout v109-plan-help"><b>Comment lire le plan ?</b><span>1. Choisis une variante. 2. Choisis Fonctions, Coûts, Risques ou Flux. 3. Appuie sur une zone pour voir son coût indicatif, son niveau de risque, ses contraintes et les actions à valider.</span><small>C’est un programme fonctionnel, pas un plan d’architecte coté.</small></div>')}
J.visual=n=>{if(n==='Plan 2D')return J.downloadPdf?.('plan');if(n==='Croquis concept')return J.downloadPdf?.('concept');if(n==='Infographie')return J.downloadPdf?.('decision');if(n==='Storyboard vidéo')return J.downloadPdf?.('storyboard');const z=typeof variantSurfaces==='function'?variantSurfaces():[],p=`${n.toUpperCase()} - ${state.name||'Projet'}\n\nLieu : ${state.v109.place.siteName||siteLabels[state.site]||state.site} - ${state.location||'à définir'}.\nConcept : ${state.idea||'à compléter'}.\nObjectif : ${state.goal||'à définir'}.\nProgramme : ${z.map(x=>x[0]+' '+x[1]+'%').join(' ; ')}.\n\nNe pas inventer dimensions ou éléments physiques non fournis. Respecter sécurité, PMR et flux.`;J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">LIVRABLE VISUEL</span><h2>${E(n)}</h2></div><span class="status alert">IA requise</span></div><div class="callout"><b>Le bouton est actif.</b> Ce livrable photoréaliste nécessite un moteur d’image ; Project Lab prépare le brief complet.</div><textarea id="v109VisualPrompt" class="field v109-draft-text">${E(p)}</textarea><div class="row v109-sheet-actions"><button class="btn primary" data-v109-copy-visual>Copier le brief</button><button class="btn" data-v109-chat>Ouvrir ChatGPT</button><button class="btn ghost" data-v109-pdf="visual-brief" data-v109-visual="${E(n)}">PDF du brief</button></div>`)};
function pdfButtons(){const map={analysis:'Analyse 360',control:'Tour de contrôle',finance:'Finances',risks:'Risques',pilot:'Pilotage',visuals:'Plan',roadmap:'Feuille de route',documents:'Documents',execution:'Montage',territory:'Territoire',premium:'Audit premium',dossier:'Dossier complet'};Object.entries(map).forEach(([id,n])=>{const h=$('#'+id+' .section-title');if(h&&!h.querySelector('[data-v109-pagepdf]'))h.insertAdjacentHTML('beforeend',`<button class="btn small ghost no-print v109-pdf-head" data-v109-pagepdf="${id}">PDF · ${n}</button>`)});const g=$('#deliverables .deliverable-grid');if(g&&!$('#v109PdfCenter'))g.insertAdjacentHTML('afterend',`<div id="v109PdfCenter" class="card v109-pdf-center"><div class="card-head"><div><span class="eyebrow">CENTRE PDF V10.9</span><h3>Tous les livrables importants</h3></div><span class="pill">A4 personnalisé</span></div><div class="v109-pdf-grid">${[['decision','Fiche décision'],['analysis','Analyse 360'],['control','Tour de contrôle'],['finance','Finances'],['risks','Risques'],['pilot','Pilotage'],['plan','Plan fonctionnel'],['roadmap','Feuille de route'],['documents','Documents & autorisations'],['execution','Montage'],['territory','Territoire'],['premium','Audit premium'],['master','Dossier complet']].map(x=>`<button class="btn ghost" data-v109-pdf="${x[0]}">${x[1]}</button>`).join('')}</div></div>`);const lm={downloadDecisionSvg:'decision',downloadRiskSvg:'risks',downloadPlanSvg:'plan',downloadRoadmapV8:'roadmap',printDossierV8:'master'};Object.entries(lm).forEach(([id,t])=>{const b=$('#'+id);if(b){b.dataset.v109Pdf=t;b.textContent='Télécharger PDF'}})}
async function territory(){commitPlace();if(!state.location){toast('Choisis d’abord une commune / un territoire');showPage('project');setTimeout(()=>$('#v109PlacePanel')?.scrollIntoView({behavior:'smooth'}),100);return}const b=$('#researchTerritoryBtn'),s=$('#territoryStatus'),txt=b?.textContent;if(b){b.disabled=true;b.textContent='Analyse en cours…'}if(s)s.innerHTML='<b>Étape 1/3 - Identification de la commune…</b>';const t=setTimeout(()=>{if(s)s.innerHTML=`<b>Étape 2/3 - Écosystème dans ${Math.round((state.territory.radius||5000)/1000)} km…</b> Sur 20 km, OpenStreetMap peut prendre plusieurs secondes.`},1000);try{await J.originalTerritory();if(state.territory?.live){s?.insertAdjacentHTML('afterbegin','<div class="v109-territory-done"><b>Étape 3/3 - Terminé.</b> Résultats ci-dessous.</div>');setTimeout(()=>$('#territoryKpis')?.scrollIntoView({behavior:'smooth'}),100)}}finally{clearTimeout(t);if(b){b.disabled=false;b.textContent=txt||'Analyser le territoire'}}}
function wrappers(){const rc=W.renderControl;W.renderControl=function(){rc?.();decorate()};const rr=W.renderRisks;W.renderRisks=function(){rr?.();decorate()};const rp=W.renderPilot;W.renderPilot=function(){rp?.();decorate()};const rd=W.renderDashboard;W.renderDashboard=function(){rd?.();decorate()};const rv=W.renderVisualBriefsV5;W.renderVisualBriefsV5=function(){rv?.();decorate()};const ra=W.renderAll;W.renderAll=function(){ra?.();J.ensure();syncPlace();syncId();banner();decorate();pdfButtons()};const fp=W.fillProject;W.fillProject=function(){fp?.();setTimeout(syncPlace,0)};const rpjt=W.readProject;W.readProject=function(){rpjt?.();commitPlace()};const np=W.newProject;W.newProject=function(){np?.();J.ensure();state.isExample=false;state.type='free';state.site='unknown';state.ownership='unknown';state.location='';state.v109.place={status:'searching',siteName:'',address:'',postalCode:'',parcel:''};if($('#type'))$('#type').value='free';syncPlace();save(false);banner()};const lt=W.loadTest;W.loadTest=function(){lt?.();state.isExample=true;J.ensure();save(false);banner();toast('Exemple guinguette chargé - ce n