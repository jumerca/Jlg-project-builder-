 if(['master','execution'].includes(type)&&typeof permitTemplates==='function'){add('Autorisations / validations',permitTemplates().map(x=>it(x.name,`${x.why} - Interlocuteur : ${x.owner}`,state.execution?.permits?.[x.id]||'À traiter')));if(state.execution?.quotes?.length)add('Devis',state.execution.quotes.map(x=>it(x.supplier,`${x.cat} - ${x.note||''}`,fmt(x.amount))))}
