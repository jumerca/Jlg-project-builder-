 if(['master','analysis'].includes(type)){add('Analyse 360',[kv('Viabilité',s.vi+'/100'),kv('Potentiel',s.pot+'/100'),kv('Complexité',s.complex+'/100'),kv('Risque',s.risk+'/100')]);add('Forces',positives().map(x=>it(x)));add('Challenge',challenge().map(x=>it(x)));add('Renforcement',repairs().map(x=>it(x)))}
