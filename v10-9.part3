plantation et fonctionnement.','Passer aux devis, commandes, travaux et dépendances.','Tester les procédures avant ouverture.','Ouvrir avec rôles et indicateurs clairs.','Comparer réel/prévisionnel et corriger.'][i])}</p></div><div class="callout">La barre du Gantt montre l’ordre logique, pas un avancement automatique. Les vrais statuts se pilotent dans Feuille de route et Montage V7.</div><div class="row v109-sheet-actions"><button class="btn primary" data-v109-route="${p}">Ouvrir la rubrique</button><button class="btn ghost" data-v109-pdf="pilot">PDF pilotage</button></div>`)};
J.raci=i=>{const r=[['Décision','R réalise/prépare, A valide et assume, C est consulté, I est informé.'],['Lieu & autorisations','Clarifie qui obtient les accords et qui a le dernier mot sur le lieu.'],['Finances','Clarifie qui construit les hypothèses et qui valide le financement.'],['Technique','Clarifie exécution, contrôle et responsabilité technique.'],['Lancement','Clarifie qui exécute, décide, conseille et doit être informé.']][i];if(!r)return;J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">MATRICE RACI</span><h2>${E(r[0])}</h2></div></div><div class="v109-detail-card"><span>Utilité</span><p>${E(r[1])}</p></div><div class="v109-detail-card"><span>RACI</span><p><b>R</b> Responsible = fait · <b>A</b> Accountable = valide/assume · <b>C</b> Consulted = consulté avant décision · <b>I</b> Informed = informé.</p></div><button class="btn primary" data-v109-route="execution">Gérer les parties prenantes</button>`)};
function banner(){let b=$('#v109ExampleBanner');if(!b){b=document.createElement('div');b.id='v109ExampleBanner';b.className='v109-example hidden no-print';$('#tabs')?.insertAdjacentElement('afterend',b)}if(J.example()){b.classList.remove('hidden');b.innerHTML='<div><span class="status alert">MODE EXEMPLE</span><b>Guinguette du Lac</b><small>Ce projet est une démonstration. Le lieu, les coûts et les réponses ne sont pas les tiens.</small></div><button class="btn small primary" data-v109-new>Créer mon propre projet</button>'}else b.classList.add('hidden')}
function placePanel(){J.ensure();if($('#v109PlacePanel'))return;const first=$('#project .section-title + .card');if(!first)return;first.insertAdjacentHTML('beforebegin',`<div id="v109PlacePanel" class="card v109-place-card"><div class="card-head"><div><span class="eyebrow">LIEU DU PROJET</span><h3>Choisis réellement où se passe ton projet</h3></div><span class="pill">modifiable</span></div><p class="muted">Le lieu pilote ensuite les questions, les risques, les autorisations et Territoire live.</p><div class="grid g3 v109-place-grid"><label>État du choix<select id="v109PlaceStatus" class="field"><option value="searching">Je cherche / compare</option><option value="identified">Lieu identifié</option><option value="secured">Lieu sécurisé</option></select></label><label>Nom du site / local<input id="v109SiteName" class="field"></label><label>Commune / territoire<input id="v109Location" class="field" placeholder="Ex. Pompadour, Corrèze"></label><label>Type de site<select id="v109Site" class="field"></select></label><label>Statut du lieu<select id="v109Ownership" class="field"></select></label><label>Adresse précise<input id="v109Address" class="field" placeholder="Optionnelle"></label><label>Code postal<input id="v109Postal" class="field"></label><label>Parcelle / référence<input id="v109Parcel" class="field" placeholder="Optionnelle"></label></div><div class="row v109-place-actions"><button class="btn small" data-v109-territory>Analyser ce territoire</button><span class="muted mini">Si aucun lieu n’est choisi, l’app ne doit pas en inventer un.</span></div></div>`);$('#v109Site').innerHTML=$('#site')?.innerHTML||'';$('#v109Ownership').innerHTML=$('#ownership')?.innerHTML||'';['site','ownership','location'].forEach(id=>$('#'+id)?.closest('label')?.classList.add('v109-original-place-field'));syncPlace()}
function syncPlace(){J.ensure();const p=state.v109.place,set=(id,v)=>{const e=$(id);if(e&&document.activeElement!==e)e.value=v??''};set('#v109PlaceStatus',p.status);set('#v109SiteName',p.siteName);set('#v109Location',state.location);set('#v109Site',state.site);set('#v109Ownership',state.ownership);set('#v109Address',p.address);set('#v109Postal',p.postalCode);set('#v109Parcel',p.parcel)}
function commitPlace(){J.ensure();const p=state.v109.place;p.status=$('#v109PlaceStatus')?.value||p.status;p.siteName=$('#v109SiteName')?.value.trim()||'';p.address=$('#v109Address')?.value.trim()||'';p.postalCode=$('#v109Postal')?.value.trim()||'';p.parcel=$('#v109Parcel')?.value.trim()||'';state.location=$('#v109Location')?.value.trim()??state.location;state.site=$('#v109Site')?.value??state.site;state.ownership=$('#v109Ownership')?.value??state.ownership;if($('#location'))$('#location').value=state.location;if($('#site'))$('#site').value=state.site;if($('#ownership'))$('#ownership').value=state.ownership}
function identity(){J.ensure();if($('#v109Identity'))return;const d=$('#dossierContent');if(!d)return;d.insertAdjacentHTML('beforebegin',`<div id="v109Identity" class="card v109-identity no-print"><div class="card-head"><div><span class="eyebrow">IDENTITÉ DES PDF</span><h3>Personnalise les livrables</h3></div><span class="pill">local</span></div><div class="grid g3"><label>Profil<select id="v109IdentityKind" class="field"><option value="private">Particulier</option><option value="company">Entreprise</option><option value="association">Association</option><option value="public">Collectivité / organisme public</option></select></label><label>Nom / raison sociale<input id="v109IdentityName" class="field"></label><label>Contact<input id="v109IdentityContact" class="field"></label><label>E-mail<input id="v109IdentityEmail" class="field"></label><label>Téléphone<input id="v109IdentityPhone" class="field"></label><label>Adresse<input id="v109IdentityAddress" class="field"></label></div><div class="v109-logo-line"><div id="v109LogoPreview" class="v109-logo-preview">Logo</div><div><label class="btn small ghost v109-file-btn">Choisir un logo<input id="v109LogoFile" type="file" accept="image/png,image/jpeg,image/webp" hidden></label> <button class="btn small ghost" data-v109-logo-clear>Retirer</button><p class="muted mini">Le logo et ces coordonnées apparaissent sur les PDF.</p></div></div></div>`);syncId()}
function syncId(){J.ensure();const i=state.v109.identity,set=(id,v)=>{const e=$(id);if(e&&document.activeElement!==e)e.value=v||''};set('#v109IdentityKind',i.kind);set('#v109IdentityName',i.name);set('#v109IdentityContact',i.contact);set('#v109IdentityEmail',i.email);set('#v109IdentityPhone',i.phone);set('#v109IdentityAddress',i.address);if($('#v109LogoPreview'))$('#v109LogoPreview').innerHTML=i.logoData?`<img src="${i.logoData}">`:'Logo'}
function commitId(){J.ensure();const i=state.v109.identity;i.kind=$('#v109IdentityKind')?.value||i.kind;i.name=$('#v109IdentityName')?.value.trim()||'';i.contact=$('#v109IdentityContact')?.value.trim()||'';i.email=$('#v109IdentityEmail')?.value.trim()||'';i.phone=$('#v109IdentityPhone')?.value.trim()||'';i.address=$('#v109IdentityAddress')?.value.trim()||''}
async function logoFile(f){if(!f)return;if(f.size>5e6)return toast('Logo trop lourd (5 Mo max)');const u=URL.createObjectURL(f),im=new Image();await new Promise((ok,no)=>{im.onload=ok;im.onerror=no;im.src=u});const c=document.createElement('canvas');c.width=c.height=420;const x=c.getContext('2d'),r=Math.min(380/im.width,380/im.height),w=im.width*