)?'Preuve marché détectée':'Aucune preuve marché';if(/Juridique/.test(n))return state.evidence.some(e=>/mairie|autor|bail|erp|assur|urbanisme|convention/i.test(e.label+' '+e.detail))?'Élément juridique détecté':'Aucun élément juridique';if(/Assurance/.test(n))return state.answers.insurance||'Non abordée';if(/Accès/.test(n))return state.answers.access||'Non abordés';if(/PMR/.test(n))return state.answers.pmr||'Non abordée';if(/Plan B/.test(n))return state.answers.weather||'Non formalisé';if(/Échéance/.test(n))return state.deadline||'Aucune date cible';if(/Charge humaine/.test(n))return state.finance.staff?fmt(state.finance.staff)+'/mois':'Aucun coût de personnel';return 'Calcul moteur';};
J.sheet=html=>{let w=$('#v109Sheet');if(!w){document.body.insertAdjacentHTML('beforeend','<div id="v109Sheet" class="v109-sheet-wrap hidden"><div class="v109-sheet-backdrop" data-v109-close></div><section class="v109-sheet" role="dialog"><div class="v109-sheet-grab"></div><button class="v109-sheet-close" data-v109-close>×</button><div id="v109SheetBody"></div></section></div>');w=$('#v109Sheet')}$('#v109SheetBody').innerHTML=html;w.classList.remove('hidden');document.body.classList.add('v109-no-scroll')};
J.close=()=>{$('#v109Sheet')?.classList.add('hidden');document.body.classList.remove('v109-no-scroll')};
J.control=i=>{const c=controls()[i];if(!c)return;const m=J.meta(c.name),cls=c.status==='OK'?'ok':c.status==='ALERTE'?'alert':'block';J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">CONTRÔLE ${String(i+1).padStart(2,'0')}</span><h2>${E(c.name)}</h2></div><span class="status ${cls}">${c.status}</span></div><div class="v109-detail-grid"><div class="v109-detail-card"><span>Valeur / preuve actuelle</span><b>${E(J.value(c.name))}</b></div><div class="v109-detail-card"><span>À quoi sert ce contrôle ?</span><p>${E(m.why)}</p></div><div class="v109-detail-card"><span>${c.status==='OK'?'Preuve à conserver':'Ce qui manque / attendu'}</span><p>${E(m.proof)}</p></div><div class="v109-detail-card"><span>Action recommandée</span><p>${E(c.action)}</p></div></div><div class="v109-draft-box"><span class="eyebrow">DOCUMENT CONSEILLÉ</span><h3>${E(m.doc)}</h3><p>L’app peut préparer un brouillon ou une fiche PDF. Une autorisation/attestation officielle reste à obtenir auprès de l’organisme compétent.</p></div><div class="row v109-sheet-actions"><button class="btn primary" data-v109-route="${m.route}">Traiter maintenant</button><button class="btn" data-v109-draft="${i}">Voir le brouillon</button><button class="btn ghost" data-v109-pdf="control-one" data-v109-index="${i}">PDF de ce contrôle</button></div>`)};
J.draft=i=>{const c=controls()[i],m=J.meta(c.name),p=state.v109.place,id=state.v109.identity;const t=`${m.doc}\n\nProjet : ${state.name||'À renseigner'}\nPorteur : ${id.name||id.contact||'À renseigner'}\nLieu : ${p.siteName||siteLabels[state.site]||'À définir'} - ${state.location||'territoire à définir'}\nDate : ${new Date().toLocaleDateString('fr-FR')}\n\nPoint traité\n${c.name}\n\nSituation actuelle\n${J.value(c.name)}\n\nPourquoi ce point compte\n${m.why}\n\nPreuve / résultat attendu\n${m.proof}\n\nAction proposée\n${c.action}\n\nDécision / résultat\n[À compléter]\n\nPièces / sources\n[À compléter]\n\nCe brouillon structure la démarche et ne remplace pas un document officiel.`;J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">BROUILLON PRÉREMPLI</span><h2>${E(m.doc)}</h2></div></div><textarea id="v109DraftText" class="field v109-draft-text">${E(t)}</textarea><div class="row v109-sheet-actions"><button class="btn primary" data-v109-copy-draft>Copier</button><button class="btn" data-v109-pdf="control-one" data-v109-index="${i}">Télécharger PDF</button><button class="btn ghost" data-v109-route="${m.route}">Aller à la rubrique</button></div>`)};
J.risk=i=>{const r=risks()[i];if(!r)return;J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">RISQUE</span><h2>${E(r.name)}</h2></div><span class="status ${r.score>=35?'block':r.score>=20?'alert':'ok'}">Score ${r.score}</span></div><div class="v109-kpi-row"><div><span>Probabilité</span><b>${r.p}%</b></div><div><span>Gravité</span><b>${r.s}%</b></div><div><span>Maîtrise</span><b>${r.m}%</b></div><div><span>Score</span><b>${r.score}</b></div></div><div class="v109-detail-card"><span>Mesure proposée</span><p>${E(r.mit)}</p></div><div class="v109-detail-card"><span>Lecture</span><p>Le score combine probabilité, gravité et maîtrise. Il doit être confirmé par les faits, les documents et les professionnels adaptés au projet.</p></div><div class="row v109-sheet-actions"><button class="btn primary" data-v109-route="${/Financier/.test(r.name)?'finance':/Marché/.test(r.name)?'documents':'execution'}">Réduire ce risque</button><button class="btn ghost" data-v109-pdf="risks">PDF des risques</button></div>`)};
const GINFO={G0:['Intention','Le projet est-il assez clair pour être étudié ?','Concept, cible et objectif.'],G1:['Lieu','Peut-on réellement utiliser ce lieu ?','Site, statut, droit d’usage, preuve et accès.'],G2:['Marché','La demande et le prix sont-ils crédibles ?','Cible, prix, volume et preuve marché.'],G3:['Juridique / sécurité','Le projet peut-il être exploité légalement et en sécurité ?','Assurance, PMR, accès/secours et preuves juridiques.'],G4:['Finances','Le modèle économique et le financement tiennent-ils ?','Résultat, scénario prudent, marge, budget et financement.'],G5:['Prêt à lancer','L’ensemble du dossier est-il assez solide pour engager le lancement ?','Confiance, viabilité, risque résiduel et blocages.']};
J.gate=i=>{const g=gates()[i],a=GINFO[g?.code];if(!g||!a)return;const open=controls().filter(x=>x.status!=='OK').slice(0,6);J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">PORTE ${g.code}</span><h2>${E(g.name)}</h2></div><span class="status ${g.status==='GO'?'ok':g.status==='CONDITIONNEL'?'alert':'block'}">${g.status}</span></div><div class="v109-gate-score"><strong>${g.score}/100</strong><div class="scorebar"><i style="width:${g.score}%"></i></div></div><div class="v109-detail-card"><span>À quoi sert cette porte ?</span><p>${E(a[1])}</p></div><div class="v109-detail-card"><span>Critères principaux</span><p>${E(a[2])}</p></div><div class="v109-detail-card"><span>Blocages/alertes encore ouverts</span>${open.length?'<ul>'+open.map(x=>`<li><b>${x.status}</b> - ${E(x.name)}</li>`).join('')+'</ul>':'<p>Aucun blocage interne majeur. Confirme les preuves externes avant le GO.</p>'}</div><div class="row v109-sheet-actions"><button class="btn primary" data-v109-route="control">Ouvrir la Tour de contrôle</button><button class="btn ghost" data-v109-pdf="pilot">PDF pilotage</button></div>`)};
const PH=['Cadrage','Étude du lieu','Validation marché','Juridique & sécurité','Prévisionnel','Financement','Conception','Achats / travaux','Préouverture','Lancement','Optimisation'];
J.phase=i=>{const n=PH[i];if(!n)return;const p=i<2?'project':i===2?'documents':i===3?'execution':i<6?'finance':'roadmap';J.sheet(`<div class="v109-sheet-head"><div><span class="eyebrow">PHASE ${i+1}</span><h2>${E(n)}</h2></div></div><div class="v109-detail-card"><span>À quoi ça sert ?</span><p>${E(['Définir le projet et ses critères de réussite.','Vérifier le lieu, ses droits, réseaux et contraintes.','Prouver la demande, le prix et le volume.','Sécuriser autorisations, assurances, PMR et sécurité.','Construire un modèle économique et des scénarios.','Boucler les ressources et la trésorerie.','Traduire le concept en im